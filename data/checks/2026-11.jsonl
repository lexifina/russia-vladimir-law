-24T15:02:38Z", "bytes": 1468, "method": "GET", "status": 200, "url": "http://publication.pravo.gov.ru/api/Document?eoNumber=3300201507020001"}, {"at": "2026-11-24T15:02:42Z", "bytes": 1983, "method": "GET", "status": 200, "url": "http://publication.pravo.gov.ru/api/Document?eoNumber=3300201412040003"}], "runner": "lawwatch russia (65e3dde363)", "schema": "lexifina-check/1", "seen": {"added": ["3300202611060006", "3300202611060008", "3300202611060009", "3300202611060011", "3300202611060012", "3300202611060013", "3300202611060014", "3300202611060015", "3300202611060016", "3300202611060017", "3300202611060018", "3300202611060019", "3300202611060020", "3300202611090001", "3300202611090002", "3300202611090003", "3300202611090004", "3300202611090005", "3300202611090006"], "changed": [], "removed": []}, "snapshot": "2007 law-type documents in block region33; newest published 2026-11-09", "source": "pravo-vladimir", "started": "2026-11-24T15:00:45Z", "titles": {"3300202611060006": "О внесении изменений в Закон Владимирской области «Об областном бюджете на 2026 год и на плановый период 2027 и 2028 годов»", "3300202611060008": "О внесении изменения в статью 2 Закона Владимирской области «О внесении изменений в Закон Владимирской области «Об административных правонарушениях во Владимирс", "3300202611060009": "Об утверждении заключения дополнительного соглашения № 4 от 21 августа 2026 года к концессионному соглашению от 1 апреля 2017 года в отношении объектов системы ", "3300202611060011": "О переводе земельного участка из категории земли сельскохозяйственного назначения в категорию земли промышленности, энергетики, транспорта, связи, радиовещания,", "3300202611060012": "О преобразовании сельского населенного пункта на территории Ковровского муниципального округа Владимирской области и о внесении изменения в Закон Владимирской о", "3300202611060013": "О внесении изменения в статью 4 Закона Владимирской области «О туристской деятельности во Владимирской области»", "3300202611060014": "Об утверждении заключения дополнительного соглашения № 4 от 21 августа 2026 года к концессионному соглашению от 22 ноября 2018 года в отношении объектов системы", "3300202611060015": "Об утверждении заключения дополнительного соглашения № 5 от 25 августа 2026 года к концессионному соглашению от 22 ноября 2018 года в отношении объектов системы", "3300202611060016": "Об утверждении заключения дополнительного соглашения № 1 от 10 декабря 2025 года к концессионному соглашению от 14 мая 2024 года в отношении объектов теплоснабж", "3300202611060017": "О внесении изменений в статью 1 Закона Владимирской области «О регулировании земельных отношений на территории Владимирской области»", "3300202611060018": "О внесении изменения в статью 5 Закона Владимирской области «Об образовании во Владимирской области и признании утратившими силу отдельных Законов Владимирской ", "3300202611060019": "О внесении изменений в статью 3 Закона Владимирской области «Об обороте земель сельскохозяйственного назначения на территории Владимирской области»", "3300202611060020": "О внесении изменения в статью 5 Закона Владимирской области «О комиссиях по делам несовершеннолетних и защите их прав во Владимирской области»", "3300202611090001": "Об утверждении прогнозного плана (программы) приватизации государственного имущества Владимирской области на плановый период 2027 – 2029 годов и признании утрат", "3300202611090002": "О внесении изменений в статью 2 Закона Владимирской области «О патентной системе налогообложения во Владимирской области и признании утратившим силу Закона Влад", "3300202611090003": "О внесении изменений в Закон Владимирской области «Об отдельных вопросах, связанных с предоставлением гражданам для собственных нужд земельных участков для разм", "3300202611090004": "О внесении изменений в статью 2 Закона Владимирской области «О физической культуре и спорте во Владимирской области»", "3300202611090005": "О внесении изменений в статью 7 Закона Владимирской области «О государс